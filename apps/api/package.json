    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.165.0"
  }
