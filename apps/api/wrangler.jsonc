{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "affiliateos-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "APP_VERSION": "1.1.0",
    // Comma-separated browser origins allowed to call /api/* (Tauri webview + Vite dev server)
    "ALLOWED_ORIGINS": "tauri://localhost,http://tauri.localhost,http://localhost:1420",
    "PUBLIC_BASE_URL": "https://affiliateos-api.rakshitdembla.workers.dev",
    // Meta now requires "Unified login" (Facebook Login for Business) for new apps. IDs below are public, not secrets.
    "IG_LOGIN_MODE": "unified",
    "META_APP_ID": "1612067306883077",
    "FB_LOGIN_CONFIG_ID": "1599197921970843",
    "IG_APP_ID": "",
    "IG_GRAPH_VERSION": "v27.0",
    // Public contact shown on /privacy, /terms and /data-deletion.
    "PRIVACY_CONTACT": "rakshitspeaks@gmail.com"
  },
  // Secrets (never in this file): ADMIN_API_TOKEN, META_APP_SECRET (Unified login), IG_APP_SECRET (Instagram Login only), IG_WEBHOOK_VERIFY_TOKEN, TOKEN_ENCRYPTION_KEY
  "triggers": { "crons": ["17 3 * * *"] },
  "workers_dev": true,
  "preview_urls": false,
  // Per-IP limit on view/click recording from public pages (60 per minute per IP and kind).
  "ratelimits": [{ "name": "PUBLIC_RL", "namespace_id": "4801", "simple": { "limit": 60, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affiliateos",
      // Created with `wrangler d1 create affiliateos` (an ID is an identifier, not a secret).
      "database_id": "46ff819b-a565-4e88-a529-9f3f1e7e008a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "affiliateos-images"
    }
  ]
}
